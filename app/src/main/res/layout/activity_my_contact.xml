<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="header"
        android:background="@drawable/bg_header"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_circle_soft"
            android:gravity="center"
            android:text="👤"
            android:textSize="37sp" />

        <TextView
            
            style="@style/Text.Tour.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="My Emergency Contact" />

        <TextView
            
            style="@style/Text.Tour.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Someone you trust" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/contactName"
                    style="@style/Widget.Tour.Input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="0dp"
                    android:hint="Name (for example: Mom)"
                    android:importantForAutofill="yes"
                    android:inputType="textPersonName" />
                <EditText
                    android:id="@+id/contactPhone"
                    style="@style/Widget.Tour.Input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:hint="Phone number (+91…)"
                    android:importantForAutofill="yes"
                    android:inputType="phone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveContactButton"
            style="@style/Widget.Tour.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="Save contact" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/callContactButton"
            style="@style/Widget.Tour.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="📞  Call contact" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/smsContactButton"
            style="@style/Widget.Tour.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/contact_sms_button" />
        <TextView
            
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Saved only on this phone. Messages open in your SMS app and are sent only when you press send. In danger, call 112."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backContactButton"
        style="@style/Widget.Tour.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="← Back" />

</LinearLayout>
