<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F8F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="My Emergency Contact"
        android:textColor="#111827"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Saved only on this phone"
        android:textColor="#64748B"
        android:textSize="14sp" />
    <EditText
        android:id="@+id/contactName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="#FFFFFF"
        android:hint="Name (for example: Mom)"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#111827"
        android:textColorHint="#94A3B8"
        android:textSize="16sp" />
    <EditText
        android:id="@+id/contactPhone"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="#FFFFFF"
        android:hint="Phone number (+91…)"
        android:inputType="phone"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#111827"
        android:textColorHint="#94A3B8"
        android:textSize="16sp" />
    <Button
        android:id="@+id/saveContactButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="Save contact"
        android:textSize="16sp"
        android:backgroundTint="#0F766E"
        android:textColor="#FFFFFF" />
    <Button
        android:id="@+id/callContactButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="📞 Call contact"
        android:textSize="16sp" />
    <Button
        android:id="@+id/smsContactButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="@string/contact_sms_button"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Messages open in your SMS app and are sent only when you press send. In danger, call 112."
        android:textColor="#64748B"
        android:textSize="12sp" />
    <Button
        android:id="@+id/backContactButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="← Back"
        android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
