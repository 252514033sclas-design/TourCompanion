<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="header"
        android:background="@drawable/bg_header"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_circle_soft"
            android:gravity="center"
            android:text="₹"
            android:textSize="37sp" />

        <TextView
            
            style="@style/Text.Tour.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Budget Calculator" />

        <TextView
            
            style="@style/Text.Tour.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Estimate your trip with a 10% safety buffer" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/budgetDays"
                    style="@style/Widget.Tour.Input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="0dp"
                    android:hint="Number of days"
                    android:importantForAutofill="yes"
                    android:inputType="numberDecimal" />
                <EditText
                    android:id="@+id/budgetPeople"
                    style="@style/Widget.Tour.Input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:hint="Number of travellers"
                    android:importantForAutofill="yes"
                    android:inputType="numberDecimal" />
                <EditText
                    android:id="@+id/budgetStay"
                    style="@style/Widget.Tour.Input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:hint="Stay per night, whole group (₹)"
                    android:importantForAutofill="yes"
                    android:inputType="numberDecimal" />
                <EditText
                    android:id="@+id/budgetFood"
                    style="@style/Widget.Tour.Input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:hint="Food per person per day (₹)"
                    android:importantForAutofill="yes"
                    android:inputType="numberDecimal" />
                <EditText
                    android:id="@+id/budgetTransport"
                    style="@style/Widget.Tour.Input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:hint="Transport per person per day (₹)"
                    android:importantForAutofill="yes"
                    android:inputType="numberDecimal" />
                <EditText
                    android:id="@+id/budgetActivities"
                    style="@style/Widget.Tour.Input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:hint="Activities per person per day (₹)"
                    android:importantForAutofill="yes"
                    android:inputType="numberDecimal" />
                <EditText
                    android:id="@+id/budgetOther"
                    style="@style/Widget.Tour.Input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:hint="Other per person per day (₹)"
                    android:importantForAutofill="yes"
                    android:inputType="numberDecimal" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/calcBudgetButton"
            style="@style/Widget.Tour.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="Calculate" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/primary_tint"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/budgetResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="5dp"
                android:minHeight="64dp"
                android:padding="18dp"
                android:textColor="@color/primary_dark"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backBudgetButton"
        style="@style/Widget.Tour.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="← Back" />

</LinearLayout>
