<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F8F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <com.example.tourcompanion.SaathiView
        android:id="@+id/voiceAvatar"
        android:layout_width="match_parent"
        android:layout_height="150dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Voice Check"
        android:textColor="#111827"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Tests speaking and listening on this phone"
        android:textColor="#64748B"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/voiceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:lineSpacingExtra="4dp"
        android:padding="14dp"
        android:textColor="#111827"
        android:textSize="15sp" />
    <Button
        android:id="@+id/testSpeakButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="🔊 Test speaking"
        android:textSize="16sp"
        android:backgroundTint="#0F766E"
        android:textColor="#FFFFFF" />
    <Button
        android:id="@+id/testMicButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="🎤 Test microphone"
        android:textSize="16sp"
        android:backgroundTint="#0F766E"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/heardText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#0F766E"
        android:textSize="15sp" />
    <Button
        android:id="@+id/voiceSettingsButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Open phone voice settings"
        android:textSize="16sp" />
    <Button
        android:id="@+id/installVoiceButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Install voice data"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="No sound? Check the media volume and that the phone is not on silent."
        android:textColor="#64748B"
        android:textSize="12sp" />
    <Button
        android:id="@+id/backVoiceButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="← Back"
        android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
