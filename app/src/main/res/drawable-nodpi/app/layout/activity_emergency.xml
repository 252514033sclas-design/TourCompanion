<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFF7F7">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emergency 112"
        android:textColor="#B91C1C"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="15dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Immediate emergency assistance"
        android:textColor="#64748B"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="6dp" />

    <com.example.tourcompanion.SaathiView
        android:id="@+id/saathiViewEmergency"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="15dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="22dp"
        app:cardElevation="2dp"
        app:strokeColor="#FECACA"
        app:strokeWidth="1dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="15dp"
            android:text="If you are in immediate danger, contact emergency services. In India, call 112."
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold" />

    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/call112Button"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="18dp"
        android:text="🚨  Call 112"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold"
        android:backgroundTint="#DC2626" />

    <Button
        android:id="@+id/backEmergencyButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:text="← Back to Home"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Emergency assistance is provided through your phone's dialer."
        android:textColor="#64748B"
        android:textSize="12sp" />

</LinearLayout>